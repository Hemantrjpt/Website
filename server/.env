# Copy this to .env and fill in your own values. Never commit the real .env file.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Used to build the URLs inside /sitemap.xml and /rss.xml. Set this to your
# real domain once you have one deployed.
SITE_URL=https://titanichub.vercel.app/client

# Any long random string — used to sign admin login sessions (JWT).
JWT_SECRET=titanichublarpyouallnoobscripters

# Admin login is now stored in src/data/admins.json (supports multiple
# accounts). Default login: admin / change-me-now — change the password
# immediately after your first login, from Site Settings → Accounts.
